#!/usr/bin/env bash
set -euo pipefail

if ! command -v cryptsetup >/dev/null ||
  ! command -v sgdisk >/dev/null ||
  ! command -v partprobe >/dev/null; then
  exec nix shell \
    nixpkgs#cryptsetup \
    nixpkgs#gptfdisk \
    nixpkgs#parted \
    nixpkgs#e2fsprogs \
    --command "$0" "$@"
fi

data_disk=/dev/nvme1n1
key_file=/root/.keys/data.key

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

[[ $EUID -eq 0 ]] || die "run this script with sudo"

for command in cryptsetup lsblk mkfs.ext4 partprobe sgdisk udevadm; do
  command -v "$command" >/dev/null || die "missing command: $command"
done

data_serial=$(tr -d '[:space:]' </sys/block/nvme1n1/device/serial)

[[ $data_serial == 2408E8992490 ]] ||
  die "$data_disk is not the expected 2 TB Crucial drive"

if lsblk -nrpo MOUNTPOINT "$data_disk" | grep -qv '^$'; then
  die "the target disk or partition is mounted"
fi

printf '%s\n' \
  "THIS PERMANENTLY ERASES:" \
  "  $data_disk: 2 TB Crucial, serial 2408E8992490" \
  "" \
  "Type ERASE to continue:"
read -r confirmation
[[ $confirmation == ERASE ]] || die "confirmation did not match"

install -d -m 0700 "$(dirname "$key_file")"
if [[ ! -e $key_file ]]; then
  dd if=/dev/urandom of="$key_file" bs=64 count=1 status=none
  chmod 0400 "$key_file"
fi

sgdisk --zap-all "$data_disk"
sgdisk --new=1:1MiB:0 --typecode=1:8309 --change-name=1:data "$data_disk"
partprobe "$data_disk"
udevadm settle

cryptsetup luksFormat --batch-mode --type luks2 \
  --uuid c6dd0f62-22ce-48b7-b048-9e22be9803a0 \
  --key-file "$key_file" "${data_disk}p1"

printf '\nSet a recovery passphrase for /data. Store it securely.\n'
cryptsetup luksAddKey --key-file "$key_file" "${data_disk}p1"

cryptsetup open --key-file "$key_file" "${data_disk}p1" data

mkfs.ext4 -L data -U b452df40-64d4-463a-95f4-925597b23e40 /dev/mapper/data

printf '\nStorage initialized. Now run:\n'
printf '  sudo nixos-rebuild switch --flake .#thor\n'
printf '  sudo chown zmeyer:users /data\n'
printf '  sudo chmod 2775 /data\n'
