;; Top bar for Hyprland. Layout:
;;   [workspaces · git]          [window title]          [media · stats · tray · rec · dnd · vol · clock · power]
;;
;; Data comes from event-driven scripts (deflisten), not polling hyprctl every second.
;; Script paths are substituted by Nix (@name@).

(deflisten hypr :initial '{"workspaces":[],"title":"","class":"","git":""}'
  "@hypr@")

(deflisten audio :initial '{"vol":0,"muted":false,"ok":false}'
  "@volume@")

(deflisten media :initial '{"status":"","player":"","artist":"","title":""}'
  "@media@")

(deflisten stats :initial '{"cpu":0,"mem":0,"down":"0B","up":"0B","iface":"","dnd":false,"rec":false}'
  "@stats@")

(defpoll battery :interval "60s" :initial ""
  "@battery@")

(defvar cal_open false)
(defvar power_open false)

;; ---------------------------------------------------------------- left

(defwidget workspaces []
  (eventbox
    :onscroll "hyprctl dispatch workspace $([ {} = up ] && echo e-1 || echo e+1)"
    (box :class "workspaces" :space-evenly false :spacing 2
      (for ws in {hypr.workspaces}
        (button
          :class "ws ${ws.active ? 'active' : ''}"
          :onclick "hyprctl dispatch workspace ${ws.id}"
          :tooltip "${ws.windows} window${ws.windows == 1 ? '' : 's'}"
          "${ws.id}")))))

(defwidget git []
  (box :class "git" :space-evenly false :visible {hypr.git != ""}
    (label :class "icon" :text "")
    (label :text {hypr.git} :limit-width 40)))

;; ---------------------------------------------------------------- center

(defwidget title []
  (label
    :class "title"
    :visible {hypr.title != ""}
    :limit-width 90
    :show-truncated true
    :tooltip {hypr.class}
    :text {hypr.title}))

;; ---------------------------------------------------------------- right

(defwidget media-widget []
  (box :class "media" :space-evenly false :spacing 2 :visible {media.status != ""}
    (button :class "media-btn" :onclick "playerctl --player=${media.player} previous" "󰒮")
    (button :class "media-btn"
      :onclick "playerctl --player=${media.player} play-pause"
      {media.status == "Playing" ? "󰏤" : "󰐊"})
    (button :class "media-btn" :onclick "playerctl --player=${media.player} next" "󰒭")
    (label
      :class "media-text ${media.status == 'Playing' ? '' : 'paused'}"
      :limit-width 40
      :tooltip "${media.artist} — ${media.title} (${media.player})"
      :text {media.artist != "" ? "${media.artist} — ${media.title}" : media.title})))

(defwidget stat [icon value ?class ?tooltip]
  (box :class "stat ${class}" :space-evenly false :tooltip tooltip
    (label :class "icon" :text icon)
    (label :text value)))

(defwidget system []
  (box :class "system" :space-evenly false :spacing 10
    (stat :class {stats.cpu >= 85 ? "hot" : ""} :icon "" :value "${stats.cpu}%" :tooltip "CPU")
    (stat :class {stats.mem >= 85 ? "hot" : ""} :icon "󰍛" :value "${stats.mem}%" :tooltip "Memory")
    (stat :class "net" :icon "󰇚" :value "${stats.down} 󰕒 ${stats.up}" :tooltip {stats.iface})
    (box :visible {battery != ""}
      (stat :class "battery" :icon "󰁹" :value battery :tooltip "Battery"))))

(defwidget indicators []
  (box :class "indicators" :space-evenly false :spacing 2
    (button :class "ind rec" :visible {stats.rec}
      :tooltip "Recording, click to stop"
      :onclick "screencast"
      "󰑊")
    (button :class "ind ${stats.dnd ? 'dnd-on' : ''}"
      :tooltip {stats.dnd ? "Do not disturb: on" : "Do not disturb: off"}
      :onclick "makoctl mode -t do-not-disturb"
      {stats.dnd ? "󰂛" : "󰂚"})))

(defwidget volume []
  (eventbox
    :onscroll "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%$([ {} = up ] && echo + || echo -)"
    :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    :onrightclick "pavucontrol >/dev/null 2>&1 &"
    :tooltip "Scroll: volume · Click: mute · Right-click: mixer"
    (box :class "stat volume ${audio.muted ? 'muted' : ''}" :space-evenly false
      (label :class "icon"
        :text {!audio.ok ? "󰖁" : audio.muted ? "󰖁" : audio.vol >= 60 ? "󰕾" : audio.vol >= 25 ? "󰖀" : "󰕿"})
      (label :text {audio.ok ? "${audio.vol}%" : "--"}))))

(defwidget clock []
  (button :class "clock ${cal_open ? 'open' : ''}"
    :onclick "@toggle@ calendar cal_open"
    :tooltip {formattime(EWW_TIME, "%A, %d %B %Y")}
    {formattime(EWW_TIME, "%a %d %b  %-I:%M %p")}))

(defwidget power []
  (button :class "power ${power_open ? 'open' : ''}"
    :onclick "@toggle@ powermenu power_open"
    :tooltip "Session"
    "󰐥"))

;; ---------------------------------------------------------------- bar

(defwidget bar []
  (centerbox :class "bar"
    (box :class "left" :halign "start" :space-evenly false :spacing 12
      (workspaces)
      (git))
    (box :class "center" :halign "center" :space-evenly false
      (title))
    (box :class "right" :halign "end" :space-evenly false :spacing 14
      (media-widget)
      (system)
      (systray :class "tray" :spacing 8 :icon-size 16 :prepend-new true)
      (indicators)
      (volume)
      (clock)
      (power))))

(defwindow bar-main
  :monitor 0
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "eww-bar"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "32px" :anchor "top center")
  (bar))

;; ---------------------------------------------------------------- popups

(defwindow calendar
  :monitor 0
  :stacking "overlay"
  :focusable false
  :namespace "eww-popup"
  :geometry (geometry :x "56px" :y "38px" :anchor "top right")
  (box :class "popup"
    (calendar :class "cal" :show-week-numbers true)))

(defwidget power-item [icon label cmd ?class]
  (button :class "power-item ${class}"
    :onclick "@toggle@ powermenu power_open; ${cmd}"
    (box :space-evenly false :spacing 10
      (label :class "icon" :text icon)
      (label :text label))))

(defwindow powermenu
  :monitor 0
  :stacking "overlay"
  :focusable false
  :namespace "eww-popup"
  :geometry (geometry :x "8px" :y "38px" :anchor "top right")
  (box :class "popup power-menu" :orientation "v" :space-evenly false
    (power-item :icon "󰌾" :label "Lock"      :cmd "loginctl lock-session")
    (power-item :icon "󰑓" :label "Reload Hyprland" :cmd "hyprctl reload")
    (power-item :icon "󰤄" :label "Suspend"   :cmd "systemctl suspend")
    (power-item :icon "󰍃" :label "Log out"   :cmd "hyprctl dispatch exit" :class "danger")
    (power-item :icon "󰜉" :label "Reboot"    :cmd "systemctl reboot" :class "danger")
    (power-item :icon "󰐥" :label "Shut down" :cmd "systemctl poweroff" :class "danger")))
